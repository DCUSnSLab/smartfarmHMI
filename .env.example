# smartfarmHMI — 개발 환경 변수
# `make env` 로 .env 에 복사 후 필요 시 수정. 포트는 AIBootcamp(5xxxx)와 동시 기동 가능하도록 4xxxx 대역.

# ── 공개 진입점 ──
PUBLIC_HOST=localhost
HOST_GATEWAY_PORT=48080          # nginx 단일 진입점

# ── 호스트 노출 포트 (디버깅용 직접 접근, 운영은 nginx만 노출) ──
HOST_DB_PORT=45432
HOST_REDIS_PORT=46379
HOST_MINIO_PORT=49000
HOST_MINIO_CONSOLE_PORT=49001
HOST_MQTT_PORT=41883
HOST_API_PORT=48000
HOST_MW_PORT=48001
HOST_WEB_PORT=43000

# ── PostgreSQL (TimescaleDB) ──
POSTGRES_DB=smartfarm
POSTGRES_USER=smartfarm
POSTGRES_PASSWORD=smartfarm_dev
# 서비스별 DB 계정 (init 스크립트가 생성, 상대 스키마 권한 없음 — db-schema.md §1)
APP_DB_PASSWORD=app_dev
MW_DB_PASSWORD=mw_dev

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── MinIO ──
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ATTACHMENTS=smartfarm-attachments
MINIO_BUCKET_VIDEOS=smartfarm-videos

# ── MQTT ──
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ── Django (api) ──
DJANGO_SECRET_KEY=dev-only-secret-key-change-me
DJANGO_DEBUG=1

# ── 시뮬레이터 ──
EDGE_SIM_FARM_ID=seongju
