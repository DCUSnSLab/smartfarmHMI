# DEV 환경 ConfigMap 값 — Secret(비밀번호·키)은 여기 두지 않는다 (README 참고)
#
# ⚠️ 이 파일은 git 에 커밋된다. 공개돼도 무방한 값만 둘 것.
#    비밀값 → Secret / 노출을 꺼리는 내부망 주소 → 클러스터 전용 ConfigMap 참고.

# ── Django (api · api-bridge · api-migrate) ──
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*

# ── DB ── 자격증명은 Secret(postgres-credentials). 계정명은 db-init 스크립트와 일치.
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=smartfarm
APP_DB_USER=app_user
MW_DB_USER=mw_user

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── MQTT ──
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ── 서비스 간 내부 통신 ──
MIDDLEWARE_URL=http://smartfarmhmi-middleware:8001

# ── MinIO ── 자격증명은 Secret(minio-credentials)
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_ATTACHMENTS=smartfarm-attachments
MINIO_BUCKET_VIDEOS=smartfarm-videos
